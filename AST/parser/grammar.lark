%import common.WS_INLINE

%import common.SH_COMMENT

%ignore WS_INLINE

%ignore SH_COMMENT

%declare _INDENT _DEDENT

// ============================================================

// NAME ROLES

// ============================================================

// Her NAME kullanımı, bulunduğu sözdizimsel bağlama göre ayrı bir

// kural altında toplanır. Böylece parser ağacında rol zaten bellidir

// ve transformer'ın tahmin yapmasına gerek kalmaz.

//

//   var_ref        -> değer olarak okunan değişken      (x + 1)

//   var_target     -> atama hedefi olan değişken        (x = 1, int x = 1, for x in ...)

//   var_decl_name  -> değersiz bildirilen değişken adı  (int x)

//   param_name     -> fonksiyon parametre adı

//   func_name      -> fonksiyon tanım adı

//   class_name     -> sınıf tanım adı

//   type_name      -> tip adı

//   member_name    -> "." sonrası üye adı               (a.member)

//   module_name    -> import/dekoratör yolundaki adlar

//   bind_name      -> import ile bağlanan yeni ad       (import x as BIND)

var_ref: NAME

var_target: NAME

var_decl_name: NAME

param_name: NAME

func_name: NAME

class_name: NAME

type_name.2: NAME

member_name: NAME

module_name: NAME

symbol_name: NAME

bind_name: NAME

// ============================================================

// PROGRAM

// ============================================================

start: (_NEWLINE | statement)* simple_stmt?

?statement: decorated_stmt
    | compound_stmt
    | simple_stmt _NEWLINE

// Son statement'ın sonunda newline olmak zorunda değil (dosya sonu / blok sonu).

suite: _NEWLINE _INDENT _block _DEDENT

_block: statement+
    | statement* simple_stmt

// ============================================================

// DECORATORS

// ============================================================

decorated_stmt: decorator+ (function_def | class_def)

decorator: "@" dotted_name ["(" [arguments] ")"] _NEWLINE

dotted_name: module_name ("." module_name)*

// ============================================================

// STATEMENTS

// ============================================================

?simple_stmt: expr_stmt
    | return_stmt
    | break_stmt
    | continue_stmt
    | pass_stmt
    | import_stmt
    | from_import_stmt

?compound_stmt: function_def
    | class_def
    | if_stmt
    | while_stmt
    | for_stmt

// ------------------------------------------------------------

// Definitions

// ------------------------------------------------------------

function_def: "def" [type_spec] func_name "(" [func_args] ")" ":" suite

func_args: typed_name ("," typed_name)* [","]

typed_name: [type_spec] param_name

type_spec: type_name MUL*

class_def: "class" class_name ":" suite

// ------------------------------------------------------------

// Control flow

// ------------------------------------------------------------

if_stmt: "if" expr ":" suite elif_clause* [else_clause]

elif_clause: "elif" expr ":" suite

else_clause: "else" ":" suite

while_stmt: "while" expr ":" suite

for_stmt: "for" type_spec? var_target IN expr ":" suite

// for hedefi: atama hedefiyle aynı ağacı üretir ama NAME için ayrı

// bir kural kullanır; böylece LALR "for x in" ile "x in y" karşılaştırmasını

// birbirine karıştırmaz.

?for_target: var_target
    | for_chain "." member_name -> attr_access
    | for_chain "[" expr "]" -> index_access

?for_chain: for_base
    | for_chain "." member_name -> attr_access
    | for_chain "[" expr "]" -> index_access
    | for_chain "(" [arguments] ")" -> call

for_base: NAME -> var_ref

return_stmt: RETURN [expr]

break_stmt: BREAK

continue_stmt: CONTINUE

pass_stmt: PASS

// ============================================================

// ASSIGNMENT

// ============================================================

// NOT: Statement başında "NAME * NAME" hem tip bildirimi (T* x) hem de

// çarpma ifadesi (a * b) olabilir. Bu gerçek bir belirsizlik (C'deki

// aynı sorun). Burada bildirim kazanır (type_name.2). Yani statement

// BAŞINDA "a * b" yazılan bir ifade ifadesi artık bildirim olarak

// okunur; bunun dışındaki yerlerde (return a * b, x = a * b, ...) çarpma

// normal çalışır.

// Tip, assignment'ın opsiyonel ilk çocuğudur: "a = 1" ve "int a = 1" aynı

// assignment düğümünü üretir, fark yalnızca type_spec çocuğunun olup

// olmamasıdır. Tip yalnızca değişken hedefinden önce yazılabilir

// ("int a.b = 1" geçersiz). Value zorunludur; değersiz bildirim ("int a")

// ayrı bir kuraldır.

declaration: type_spec var_decl_name

?expr_stmt: declaration
    | assignment
    | expr

assignment: type_spec? var_target assignment_suffix
    | member_target assignment_suffix

?assignment_suffix: ASSIGN _assignment_chain
    | AUG_ASSIGN expr

// _assignment_chain: chain_target (ASSIGN chain_target)* ASSIGN expr

//     | expr

_assignment_chain: expr

// Zincirdeki sonraki hedefler tipsizdir (a = b = 1). Tipli olamamaları

// "x = a * b" gibi ifadelerde "a *" kısmının tip sanılmasını da önler.

?chain_target: NAME -> var_target
    | postfix_expr "." member_name -> attr_access
    | postfix_expr "[" expr "]" -> index_access

// ------------------------------------------------------------

// Assignment targets

// ------------------------------------------------------------

?member_target: postfix_expr "." member_name -> attr_access
    | postfix_expr "[" expr "]" -> index_access

// ============================================================

// IMPORTS

// ============================================================

import_stmt: "import" dotted_name [AS bind_name]

from_import_stmt: "from" dotted_name "import" import_symbols

import_symbols: import_symbol ("," import_symbol)*

import_symbol: symbol_name [AS bind_name]

// ============================================================

// EXPRESSIONS

// ============================================================

?expr: or_expr

?or_expr: or_expr OR and_expr
    | and_expr

?and_expr: and_expr AND not_expr
    | not_expr

?not_expr: NOT not_expr -> logical_not
    | comparison

?comparison: comparison comparison_op sum_expr
    | sum_expr

?comparison_op: EQ
    | NE
    | LT
    | GT
    | LE
    | GE
    | IS [NOT]
    | [NOT] IN

?sum_expr: sum_expr ADD term
    | sum_expr SUB term
    | term

?term: term MUL unary
    | term DIV unary
    | term MOD unary
    | unary

?unary: (ADD | SUB) unary -> unary_op
    | postfix_expr

// ============================================================

// POSTFIX

// ============================================================

?postfix_expr: atom
    | postfix_expr "." member_name -> attr_access
    | postfix_expr "[" expr "]" -> index_access
    | postfix_expr "(" [arguments] ")" -> call

// ============================================================

// ATOMS

// ============================================================

?atom: NUMBER
    | STRING
    | TRUE -> true
    | FALSE -> false
    | NONE -> none
    | var_ref
    | list_literal
    | "(" expr ")"

list_literal: "[" [arguments] "]"

arguments: expr ("," expr)* [","]

// ============================================================

// TERMINALS

// ============================================================

_NEWLINE: (/\r?\n[\t ]*/ | SH_COMMENT)+

TRUE: "True"

FALSE: "False"

NONE: "None"

PASS: "pass"

RETURN: "return"

BREAK: "break"

CONTINUE: "continue"

ADD: "+"

SUB: "-"

MUL: "*"

DIV: "/"

MOD: "%"

EQ: "=="

NE: "!="

LT: "<"

GT: ">"

LE: "<="

GE: ">="

AND: "and"

OR: "or"

IS: "is"

NOT: "not"

IN: "in"

AS: "as"

ASSIGN: "="

AUG_ASSIGN.2: "+="
    | "-="
    | "*="
    | "/="
    | "%="

STRING: /"([^"\\\r\n]|\\.)*"|'([^'\\\r\n]|\\.)*'/

NUMBER: /[0-9]+/

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/