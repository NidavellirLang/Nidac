%import common.WS_INLINE

%import common.SH_COMMENT

%ignore WS_INLINE

%ignore SH_COMMENT

%declare _INDENT _DEDENT

// ============================================================

// PROGRAM

// ============================================================

start: (_NEWLINE | statement)*

?statement: decorated_stmt
    | compound_stmt
    | simple_stmt _NEWLINE?

suite: _NEWLINE _INDENT statement+ _DEDENT

// ============================================================

// DECORATORS

// ============================================================

decorated_stmt: decorator+ (function_def | class_def)

decorator: "@" dotted_name ["(" [arguments] ")"] _NEWLINE

dotted_name: NAME ("." NAME)*

// ============================================================

// STATEMENTS

// ============================================================

?simple_stmt: expr_stmt
    | return_stmt
    | break_stmt
    | continue_stmt
    | pass_stmt
    | import_stmt
    | from_import_stmt

?compound_stmt: function_def
    | class_def
    | if_stmt
    | while_stmt
    | for_stmt

// ------------------------------------------------------------

// Definitions

// ------------------------------------------------------------

function_def: "def" [type_spec] NAME "(" [func_args] ")" ":" suite

func_args: typed_name ("," typed_name)* [","]

typed_name: [type_spec] NAME

type_spec: type_name STAR*

type_name: NAME

class_def: "class" NAME ":" suite

// ------------------------------------------------------------

// Control flow

// ------------------------------------------------------------

if_stmt: "if" expr ":" suite elif_clause* [else_clause]

elif_clause: "elif" expr ":" suite

else_clause: "else" ":" suite

while_stmt: "while" expr ":" suite

for_stmt: "for" target "in" expr ":" suite

return_stmt: "return" [expr]

break_stmt: "break"

continue_stmt: "continue"

pass_stmt: "pass"

// ============================================================

// ASSIGNMENT

// ============================================================

expr_stmt: type_decl
    | expr [assignment_suffix]

type_decl: NAME STAR* NAME [ASSIGN expr]

assignment_suffix: aug_assign_op expr
    | ASSIGN expr

aug_assign_op: AUG_ASSIGN

// ============================================================

// IMPORTS

// ============================================================

import_stmt: "import" dotted_name ["as" NAME]

from_import_stmt: "from" dotted_name "import" import_symbols

import_symbols: import_symbol ("," import_symbol)*

import_symbol: NAME ["as" NAME]

// ============================================================

// EXPRESSIONS

// ============================================================

?expr: or_expr

?or_expr: or_expr "or" and_expr
    | and_expr

?and_expr: and_expr "and" not_expr
    | not_expr

?not_expr: "not" not_expr -> logical_not
    | comparison

?comparison: comparison comparison_op sum_expr
    | sum_expr

comparison_op: "=="
    | "!="
    | "<"
    | ">"
    | "<="
    | ">="
    | "is" ["not"]
    | ["not"] "in"

?sum_expr: sum_expr "+" term
    | sum_expr "-" term
    | term

?term: term "*" unary
    | term "/" unary
    | term "%" unary
    | unary

?unary: ("+" | "-") unary -> unary_op
    | postfix

// ============================================================

// POSTFIX

// ============================================================

?postfix: atom postfix_part*

?postfix_part: "." NAME -> attr_part
    | "[" expr "]" -> index_part
    | "(" [arguments] ")" -> call_part

// ============================================================

// ATOMS

// ============================================================

?atom: NUMBER
    | STRING
    | "True" -> true
    | "False" -> false
    | "None" -> none
    | name
    | list_literal
    | "(" expr ")"

name: NAME

list_literal: "[" [arguments] "]"

arguments: expr ("," expr)* [","]

// ============================================================

// TARGET

// ============================================================

target: postfix

// ============================================================

// TERMINALS

// ============================================================

_NEWLINE: (/\r?\n[\t ]*/ | SH_COMMENT)+

STAR: "*"

ASSIGN: "="

AUG_ASSIGN.2: "+="
    | "-="
    | "*="
    | "/="
    | "%="

STRING: /"([^"\\\r\n]|\\.)*"|'([^'\\\r\n]|\\.)*'/

NUMBER: /[0-9]+/

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/